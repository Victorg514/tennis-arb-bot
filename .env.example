# Polymarket CLOB API credentials
# Get these from: https://docs.polymarket.com

POLY_API_KEY=your-clob-api-key-here
POLY_API_SECRET=your-clob-api-secret-here
POLY_API_PASSPHRASE=your-clob-api-passphrase-here

# Ethereum private key for the wallet that will sign orders (Polygon)
# NEVER commit a real key. Generate a fresh wallet for this bot.
POLY_PRIVATE_KEY=0xyour-private-key-here

# Polling interval in seconds
POLL_INTERVAL=10

# Max spend per trade in USDC
MAX_BET_USDC=50

# Buy threshold - max price you'll pay for shares (e.g. 0.45 = 45 cents)
MAX_BUY_PRICE=0.45

# Sell target price (Polymarket resets to ~50/50)
SELL_TARGET_PRICE=0.50

# Underdog-side price rise between polls that triggers the spike detector
PRICE_SPIKE_THRESHOLD=0.05

# Dry run mode (set to false to execute real trades)
DRY_RUN=true


# Polling interval in seconds
POLL_INTERVAL=10

# Max spend per trade in USDC
MAX_BET_USDC=50

# Buy threshold - max price you'll pay for shares (e.g. 0.45 = 45 cents)
MAX_BUY_PRICE=0.45

# Sell target price (Polymarket resets to ~50/50)
SELL_TARGET_PRICE=0.50

# Underdog-side price rise between polls that triggers the spike detector
PRICE_SPIKE_THRESHOLD=0.05

# Dry run mode (set to false to execute real trades)
DRY_RUN=true

# --- News confirmation layer (Sofascore + ESPN) ---
# Mode: 'log' observes + logs only (no trade effect — use this first),
#       'gate' requires news confirmation before a trade fires,
#       'trigger' reserved for a future news-driven mode.
NEWS_CHECK_ENABLED=true
NEWS_CHECK_MODE=log
NEWS_CACHE_TTL=30

[Unit]
Description=Tennis Withdrawal Arbitrage Bot
# Bot's XSource depends on the local Nitter container being up. We don't
# hard-Requires docker.service so that a Docker outage doesn't stop the
# bot from running with Sofascore/ESPN as fallbacks — XSource degrades
# gracefully if localhost:8080 is unreachable.
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/tennis-arb-bot
EnvironmentFile=/opt/tennis-arb-bot/.env
ExecStart=/opt/tennis-arb-bot/venv/bin/python /opt/tennis-arb-bot/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/tennis-arb-bot
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
